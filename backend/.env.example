# Local MySQL (start it with `just db-up`):
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=thinky_games
MYSQL_USER=thinky
MYSQL_PASSWORD=thinky

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=525600
CORS_ORIGINS=["http://localhost:5173"]

# Required (non-empty) to use the /db/backup* admin endpoints.
ADMIN_PASSWORD=

# Optional external dictionary service. When set, word games read their pools from it.
DICTIONARY_SERVICE_URL=http://127.0.0.1:8100
DICTIONARY_SERVICE_ADMIN_PASSWORD=thinky

# Cloudinary (subida de imágenes).
CLOUDINARY_KEY=""
CLOUDINARY_SECRET=""
# Opcional: por defecto usa el cloud de NexReel.
CLOUDINARY_CLOUD_NAME="dznwlaen6"
# Carpeta de Cloudinary donde se subirán los avatares.
CLOUDINARY_FOLDER="thinkyGames"